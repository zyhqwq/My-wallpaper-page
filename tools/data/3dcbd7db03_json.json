n", "width":"655", "height":"368", "format":"webp", "kind":"", "style":"halfScreen"}, {"url":"https://bbs.hycdn.cn/image/common/20260611/131/6a2a98ecfa32f5f25b7d18f1_65de0095.webp?x-oss-process=style/fullScreen", "width":"1404", "height":"789", "format":"webp", "kind":"", "style":"fullScreen"}, {"url":"https://bbs.hycdn.cn/image/common/20260611/131/6a2a98ecfa32f5f25b7d18f1_65de0095.webp?x-oss-process=style/thirdScreen", "width":"436", "height":"245", "format":"webp", "kind":"", "style":"thirdScreen"}, {"url":"https://bbs.hycdn.cn/image/common/20260611/131/6a2a98ecfa32f5f25b7d18f1_65de0095.webp?x-oss-process=style/fullScreenLandscape", "width":"1224", "height":"689", "format":"webp", "kind":"", "style":"fullScreenLandscape"}], "isAIGC":false}], "videoList":[], "caption":[{"kind":"text", "text":{"text":"滴///信号连接中……Delta正在接入塔卫二智库系统…… ₍^_   ̫ _^₎"}}, {"kind":"text", "text":{"text":"确认完毕！塔卫二智库小编开启招募啦！成为智库小编后，管理员将参与游戏工具搭建与攻略内容建设，帮助更多管理员高效获取信息、快速定位心仪内容。当前智库系统正在持续扩容中，现诚邀更多管理员一起加入维护与升级！Delta已搜集到具体招募信息，请管理员查阅~ദ്ദി˶>ᴗo)✧"}}, {"kind":"text", "text":{"text":"▼//游戏工具介绍"}}, {"kind":"text", "text":{"text":"■《明日方舟：终末地》WIKI工具"}}, {"kind":"text", "text":{"text":"WIKI工具是由管理员们共同创作和维护的平台，该平台为管理员提供便捷、详细的游戏信息查询服务。"}}, {"kind":"text", "text":{"text":"■《明日方舟：终末地》游戏工具-配队推荐"}}, {"kind":"text", "text":{"text":"配队推荐将为管理员提供多种队伍搭配方案、干员养成建议以及局内战斗思路解析。无论是参考还是学习，希望能帮助管理员更快地组建适合自己的战斗小队，从容应对各类挑战。"}}, {"kind":"text", "text":{"text":"▼//招募时间"}}, {"kind":"text", "text":{"text":"2026年6月12日~2026年6月17日23:59"}}, {"kind":"text", "text":{"text":"▼//报名方式"}}, {"kind":"text", "text":{"text":"点击下方问卷链接进行填写。提交成功后，即视为完成报名。初筛通过后的通知将会以短信的形式发送至管理员预留的手机号，请留意后续短信通知。"}}, {"kind":"link", "link":{"link":"https://survey.hypergryph.com/s/a4d05e3dec479fa7f48b21edcb6b3ff9", "text":"《明日方舟：终末地》塔卫二智库小编第二期招募问卷"}}, {"kind":"text", "text":{"text":"▼//招募方向及成员职责"}}, {"kind":"text", "text":{"text":"【游戏工具-WIKI工具小编】负责WIKI词条的创建与内容编辑"}}, {"kind":"text", "text":{"text":"※熟悉WIKI编辑流程或具有WIKI平台搭建经验将会加分！"}}, {"kind":"text", "text":{"text":"【游戏工具-配队推荐小编】根据游戏内容或干员特性，创作配队推荐及战斗建议方案"}}, {"kind":"text", "text":{"text":"※具有游戏攻略制作经验将会加分！"}}, {"kind":"text", "text":{"text":"【攻略内容小编】编写攻略，创作游戏心得或游戏测评"}}, {"kind":"text", "text":{"text":"※具有攻略制作发表经验或对游戏理解较深将会加分！"}}, {"kind":"text", "text":{"text":"▼//成员福利"}}, {"kind":"text", "text":{"text":"森空岛【智库小编】认证。"}}, {"kind":"text", "text":{"text":"游戏工具攻略推荐、WIKI攻略推荐等。"}}, {"kind":"text", "text":{"text":"不定期发放《明日方舟：终末地》周边。"}}, {"kind":"text", "text":{"text":"更多福利敬请期待~"}}, {"kind":"text", "text":{"text":"▼//注意事项"}}, {"kind":"text", "text":{"text":"本次招募将只对已满18周岁的管理员开放。"}}, {"kind":"text", "text":{"text":"请注意填写招募的信息是否准确，问卷提交后无法修改，若信息填写有误可能导致无法与管理员取得联系。"}}], "downloadEnable":true, "coverImageId":"6a2a98ecfa32f5f25b7d18f1", "tagIds":[297], "timestamp":"1781236858", "ipLocation":"上海", "latestReplyAtTs":"1784337723", "userId":"131", "publishedAtTs":"1781236858"}, "user":{"id":"7532688806929", "nickname":"终末地Delta机器人", "profile":"滴///资料传输完毕，正在接入塔卫二智库系统——您的探索之旅，由Delta机器人守护。", "avatar":"https://bbs.hycdn.cn/asset/private/avatar/10e546ed1c89d8979629bf3a6ab59c06.webp", "isCreator":false, "identity":2, "latestIpLocation":"未知", "isModerator":false, "status":1, "operationStatus":30, "createdAtTs":"0"}, "tags":[{"id":297, "name":"明日方舟：终末地", "kind":1, "isGameEvent":false}], "itemRel":{"like":false, "collect":false}, "userRel":{"follow":false, "fans":false, "black":false, "blacked":false, "blocked":false, "fansAtTs":0}, "itemRts":{"liked":"450", "collected":"109", "reposted":"0", "commented":"102", "attitudes":[{"id":"default", "count":"449", "weight":6}, {"id":"shock", "count":"1", "weight":1}, {"id":"kiss", "count":"0", "weight":5}, {"id":"call", "count":"0", "weight":4}, {"id":"agree", "count":"0", "weight":3}, {"id":"cry", "count":"0", "weight":2}]}, "game":{"gameId":3, "name":"明日方舟：终末地"}, "cate":{"id":12, "name":"明日方舟：终末地"}}, {"item":{"id":"5918916", "viewKind":1, "gameId":3, "cateId":12, "status":1, "title":"《明日方舟：终末地》Delta速递——选剑演武玩法情报", "imageList":[{"id":"6a2a5c8e85464d4f77fc9287", "url":"htt