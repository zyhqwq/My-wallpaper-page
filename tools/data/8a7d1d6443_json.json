/131/19459cf946a247b5be2b3c49c201d492.webp?x-oss-process=style/fullScreenLandscape", "width":"362", "height":"689", "format":"webp", "kind":"", "style":"fullScreenLandscape"}], "isAIGC":false}], "videoList":[], "caption":[{"kind":"text", "text":{"text":"滴///资料传输完毕——管理员您好，我是Delta型多功能机器人，您可以叫我Delta！作为终末地工业小助手~目前我有4个核心功能，希望能够持续为管理员在塔卫二的生活探索提供帮助！"}}, {"kind":"text", "text":{"text":"💡游戏工具 提醒BOT💡"}}, {"kind":"text", "text":{"text":"为了帮助管理员更好地体验游戏，我们准备了配队推荐、地图、协议终端等游戏工具，我将持续带来这些工具的使用说明以及更新提醒。"}}, {"kind":"text", "text":{"text":"在工具使用过程中，如您有任何问题也请随时反馈，您的每一份宝贵反馈都将助力我们完善游戏工具，帮助更多管理员更加轻松地体验游戏！"}}, {"kind":"text", "text":{"text":"🔈智库小编 招募集合啦🔈"}}, {"kind":"text", "text":{"text":"为了帮助更多管理员便利地在塔卫二探索，我将不定期发布招募公告以协助招募智库小编，并助力小编搭建游戏工具及丰富攻略内容。"}}, {"kind":"text", "text":{"text":"📃玩法情报 速速送达📃"}}, {"kind":"text", "text":{"text":"为了帮助管理员更快捷地上手体验游戏玩法，我将提供各类游戏玩法的一线情报和实用小技巧。"}}, {"kind":"text", "text":{"text":"💭更多趣闻及内容💭"}}, {"kind":"text", "text":{"text":"后续将会分享更多趣闻及新的内容，以帮助管理员更好地在塔卫二进行开拓探索。"}}, {"kind":"text", "text":{"text":"滴///资料已归档，请管理员多多关照——(*^▽^*)"}}], "downloadEnable":false, "coverImageId":"6969abc944aadba6836e4e1c", "tagIds":[297], "timestamp":"1768536017", "ipLocation":"上海", "latestReplyAtTs":"1770561114", "userId":"131", "publishedAtTs":"1768536017"}, "user":{"id":"7532688806929", "nickname":"终末地Delta机器人", "profile":"滴///资料传输完毕，正在接入塔卫二智库系统——您的探索之旅，由Delta机器人守护。", "avatar":"https://bbs.hycdn.cn/asset/private/avatar/10e546ed1c89d8979629bf3a6ab59c06.webp", "isCreator":false, "identity":2, "latestIpLocation":"未知", "isModerator":false, "status":1, "operationStatus":30, "createdAtTs":"0"}, "tags":[{"id":297, "name":"明日方舟：终末地", "kind":1, "isGameEvent":false}], "itemRel":{"like":false, "collect":false}, "userRel":{"follow":false, "fans":false, "black":false, "blacked":false, "blocked":false, "fansAtTs":0}, "itemRts":{"liked":"436", "collected":"51", "reposted":"0", "commented":"67", "attitudes":[{"id":"default", "count":"435", "weight":6}, {"id":"call", "count":"1", "weight":4}, {"id":"kiss", "count":"0", "weight":5}, {"id":"agree", "count":"0", "weight":3}, {"id":"cry", "count":"0", "weight":2}, {"id":"shock", "count":"0", "weight":1}]}, "game":{"gameId":3, "name":"明日方舟：终末地"}, "cate":{"id":12, "name":"明日方舟：终末地"}}, {"item":{"id":"3345424", "viewKind":3, "gameId":3, "cateId":12, "status":1, "title":"《明日方舟：终末地》塔卫二智库小编招募开启！", "imageList":[{"id":"6904b243fd982dd93a9ef543", "url":"https://bbs.hycdn.cn/image/2025/10/31/131/880cf9517f305adc1377e69f88d1777e.webp", "width":"692", "height":"324", "size":"29804", "format":"webp", "kind":"static", "description":"", "infos":[{"url":"https://bbs.hycdn.cn/image/2025/10/31/131/880cf9517f305adc1377e69f88d1777e.webp", "width":"692", "height":"324", "format":"webp", "kind":"", "style":"origin"}, {"url":"https://bbs.hycdn.cn/image/2025/10/31/131/880cf9517f305adc1377e69f88d1777e.webp?x-oss-process=style/halfScreen", "width":"655", "height":"306", "format":"webp", "kind":"", "style":"halfScreen"}, {"url":"https://bbs.hycdn.cn/image/2025/10/31/131/880cf9517f305adc1377e69f88d1777e.webp?x-oss-process=style/fullScreen", "width":"1404", "height":"657", "format":"webp", "kind":"", "style":"fullScreen"}, {"url":"https://bbs.hycdn.cn/image/2025/10/31/131/880cf9517f305adc1377e69f88d1777e.webp?x-oss-process=style/thirdScreen", "width":"436", "height":"204", "format":"webp", "kind":"", "style":"thirdScreen"}, {"url":"https://bbs.hycdn.cn/image/2025/10/31/131/880cf9517f305adc1377e69f88d1777e.webp?x-oss-process=style/fullScreenLandscape", "width":"1404", "height":"657", "format":"webp", "kind":"", "style":"fullScreenLandscape"}], "isAIGC":false}], "videoList":[], "caption":[{"strikeThrough":false, "kind":"text", "text":{"text":"滴///正在接入塔卫二智库系统……各位管理员好！塔卫二智库小编开启招募啦~~作为塔卫二智库小编，您将负责搭建游戏工具及攻略内容，帮助更多管理员在这里方便快捷地找到心仪的内容！我们期待与您共同建设塔卫二智库！"}}, {"bold":true, "strikeThrough":false, "kind":"text", "text":{"text":"▼//游戏工具介绍"}}, {"bold":true, "strikeThrough":false, "kind":"text", "text":{"text":"■《明日方舟：终末地》WIKI工具"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"WIKI工具是由管理员们共同创作和维护的平台，该平台为管理员提供便捷、详细的游戏信息查询服务。"}}, {"bold":true, "strikeThrough":false, "kind":"text", "text":{"text":"■《明日方舟：终末地》游戏工具-配队推荐"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"配队推荐将为管理员提供多种队伍搭配方案、角色养成建议以及局内战斗思路解析。无论是参考还是学习，希望能帮助管理员更快地组建适合自己的战斗小队，从容应对各类挑战。"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"▼//招募时间"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"2025年11月1日~2025年11月7日12:00"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"▼//报名方式"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"点击下方问卷链接进行填写。提交成功后，即视为完成报名。初筛通过后将会以短信的形式发送至管理员预留的手机号，请留意后续短信通知。"}}, {"kind":"link", "link":{"link":"https://survey.hypergryph.com/s/de631499ca40a9549cabe54f5a75518c", "text":"《明日方舟：终末地》塔卫二智库小编招募问卷"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"▼//招募方向及成员职责"}}, {"bold":true, "strikeThrough":false, "kind":"text", "text":{"text":"【WIKI工具小编】"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"负责WIKI词条的创建与内容编辑"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"※熟悉WIKI编辑流程或具有WIKI平台搭建经验将会加分！"}}, {"bold":true, "strikeThrough":false, "kind":"text", "text":{"text":"【WIKI工具审核小编】"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"负责审核与纠正WIKI词条内容"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"※具有WIKI内容审核的经验将会加分！"}}, {"bold":true, "strikeThrough":false, "kind":"text", "text":{"text":"【游戏工具-配队推荐小编】"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"根据游戏内容或干员特性，创作配队推荐及战斗建议方案"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"※具有游戏攻略制作经验将会加分！"}}, {"bold":true, "strikeThrough":false, "kind":"text", "text":{"text":"【攻略内容小编】"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"编写攻略，创作游戏心得或游戏测评"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"※具有攻略制作发表经验或对游戏理解较深将会加分！"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"▼//成员福利"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"1. 森空岛【智库小编】认证"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"2. 入选后有机会获得「全面测试」体验资格"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"3. 不定期发放《明日方舟：终末地》周边"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"更多福利敬请期待~"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"▼//注意事项"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"1. 本次招募将只对已满18周岁的管理员开放。"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"2. 请注意填写招募的信息是否准确，"}}, {"bold":true, "strikeThrough":false, "kind":"text", "text":{"text":"问卷提交后无法修改"}}, {"strikeThrough":false, "kind":"text", "text":{"text":"，若信息填写有误可能导致无法与管理员取得联系。"}}], "downloadEnable":true, "coverImageId":"6904b2bf2e7c69309cff4f45", "tagIds":[297], "timestamp":"1761967800", "ipLocation":"上海", "latestReplyAtTs":"1784639145", "userId":"131", "publishedAtTs":"1761967800"}, "user":{"id":"7532688806929", "nickname":"终末地Delta机器人", "profile":"滴///资料传输完毕，正在接入塔卫二智库系统——您的探索之旅，由Delta机器人守护。", "avatar":"https://bbs.hycdn.cn/asset/private/avatar/10e546ed1c89d8979629bf3a6ab59c06.webp", "isCreator":false, "identity":2, "latestIpLocation":"未知", "isModerator":false, "status":1, "operationStatus":30, "createdAtTs":"0"}, "tags":[{"id":297, "name":"明日方舟：终末地", "kind":1, "isGameEvent":false}], "itemRel":{"like":false, "collect":false}, "userRel":{"follow":false, "fans":false, "black":false, "blacked":false, "blocked":false, "fansAtTs":0}, "itemRts":{"liked":"2763", "collected":"221", "reposted":"0", "commented":"279", "attitudes":[{"id":"default", "count":"2759", "weight":6}, {"id":"kiss", "count":"4", "weight":5}, {"id":"call", "count":"0", "weight":4}, {"id":"agree", "count":"0", "weight":3}, {"id":"cry", "count":"0", "weight":2}, {"id":"shock", "count":"0", "weight":1}]}, "game":{"gameId":3, "name":"明日方舟：终末地"}, "cate":{"id":12, "name":"明日方舟：终末地"}}], "pageToken":"", "pageSize":10, "hasMore":false}}